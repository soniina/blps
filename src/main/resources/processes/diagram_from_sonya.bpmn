    <bpmn:sequenceFlow id="Flow_0td5xm4" name="Изменить" sourceRef="Gateway_1s8p2l0" targetRef="UpdateCartService">
      <bpmn:conditionExpression>${target == 'STAY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17hjjf9" name="Оформить заказ" sourceRef="Gateway_1s8p2l0" targetRef="OrderDetailsTask">
      <bpmn:conditionExpression>${target == 'GO_TO_ORDER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0neunxg" sourceRef="UpdateCartService" targetRef="CartTask" />
