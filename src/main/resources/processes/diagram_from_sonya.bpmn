    <bpmn:sequenceFlow id="Flow_1mvoqal" name="К покупкам" sourceRef="Gateway_1s8p2l0" targetRef="BrowsingTask">
      <bpmn:conditionExpression>${target == 'GO_TO_BROWSING'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ok98es" sourceRef="BrowsingTask" targetRef="UpdateCartService" />
