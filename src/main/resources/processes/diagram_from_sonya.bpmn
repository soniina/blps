    <bpmn:sequenceFlow id="Flow_0o2uqjb" sourceRef="CreateOrderService" targetRef="CreditDetailsTask" />
    <bpmn:sequenceFlow id="Flow_0a6szhs" sourceRef="CreditDetailsTask" targetRef="CreateCreditApplicationService" />
    <bpmn:sequenceFlow id="Flow_1wttiw7" sourceRef="CreateCreditApplicationService" targetRef="SendToBanksService" />
    <bpmn:sequenceFlow id="Flow_14npyb1" sourceRef="SendToBanksService" targetRef="OffersGeneratedMessage" />
    <bpmn:sequenceFlow id="Flow_0vvybx6" sourceRef="OffersGeneratedMessage" targetRef="Gateway_14mv9h0" />
    <bpmn:sequenceFlow id="Flow_1gpooli" name="Нет" sourceRef="Gateway_14mv9h0" targetRef="Event_0zcpjxt">
      <bpmn:conditionExpression>${isApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02u5qms" name="Да" sourceRef="Gateway_14mv9h0" targetRef="Activity_068i7lh">
      <bpmn:conditionExpression>${isApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0g2wr7f" sourceRef="Activity_068i7lh" targetRef="SaveSelectedOfferService" />
    <bpmn:sequenceFlow id="Flow_06ho6j5" sourceRef="SaveSelectedOfferService" targetRef="Gateway_1brjtmj" />
    <bpmn:sequenceFlow id="Flow_0h1itet" name="Да" sourceRef="Gateway_1brjtmj" targetRef="SignApplicationTask">
      <bpmn:conditionExpression>${isOnline == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16js0ep" sourceRef="SignApplicationTask" targetRef="FinalizeSigningService" />
    <bpmn:sequenceFlow id="Flow_1jklwxd" sourceRef="FinalizeSigningService" targetRef="Event_1h6hqgs" />
    <bpmn:sequenceFlow id="Flow_1cn1t1n" sourceRef="OperatorSigningTask" targetRef="FinalizeOfflineService" />
    <bpmn:sequenceFlow id="Flow_0wvx963" sourceRef="FinalizeOfflineService" targetRef="Event_1h6hqgs" />
    <bpmn:sequenceFlow id="Flow_1eh9alw" name="Нет" sourceRef="Gateway_1brjtmj" targetRef="OperatorSigningTask">
      <bpmn:conditionExpression>${isOnline == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  
