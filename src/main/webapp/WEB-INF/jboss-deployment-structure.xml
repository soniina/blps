<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <exclude-subsystems>
            <subsystem name="logging" />
            <subsystem name="jaxrs" />
            <subsystem name="jpa" />
            <subsystem name="ejb3" />
            <subsystem name="weld" />
            <subsystem name="jsf" />
            <subsystem name="webservices" />
            <subsystem name="bean-validation" />
        </exclude-subsystems>

        <dependencies>
            <module name="deployment.warehouse-ra.rar" export="true"/>
            <module name="java.sql" export="true" />
            <module name="java.naming" export="true" />
            <module name="org.jboss.logging" export="true" />
            <module name="org.jboss.logmanager" export="true" />
            <module name="jakarta.servlet.api" export="true" />
        </dependencies>
    </deployment>
</jboss-deployment-structure>