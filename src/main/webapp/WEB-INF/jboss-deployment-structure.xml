<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure>
    <deployment>
        <local-last value="true" />
        <exclude-subsystems>
            <subsystem name="logging" />
            <subsystem name="jpa" />
            <subsystem name="jaxrs" />
            <subsystem name="weld" />
            <subsystem name="jsf" />
            <subsystem name="webservices" />
            <subsystem name="bean-validation" /> <!-- ДОБАВЬТЕ ЭТО -->
        </exclude-subsystems>
        <dependencies>
            <module name="deployment.warehouse-ra.rar" export="true"/>
            <module name="java.sql" export="true" />
            <module name="java.naming" export="true" />
            <module name="org.jboss.logging" export="true" />
            <module name="org.jboss.logmanager" export="true" />
            <module name="org.slf4j" export="true" />
        </dependencies>
    </deployment>
</jboss-deployment-structure>